                                            <div><label className="text-xs font-bold block mb-1">Eq No. <span className="text-red-500">*</span></label><input type="text" name="equipment_no" required placeholder="เช่น 11731095" defaultValue={modal.data.equipment_no} className="w-full p-2.5 rounded-lg border" /></div>
                                            <div><label className="text-xs font-bold block mb-1">Unit No. {!isAdmin && <span className="text-red-500">*</span>}</label><input type="text" name="unit_no" required={!isAdmin} placeholder="เช่น L1" defaultValue={modal.data.unit_no} className="w-full p-2.5 rounded-lg border" /></div>
                                        </div>
                                        
                                        <div><label className="text-xs font-bold block mb-1">ชื่อโครงการ <span className="text-red-500">*</span></label><input type="text" name="site_name" required placeholder="ระบุชื่อโครงการ" defaultValue={modal.data.site_name} className="w-full p-2.5 rounded-lg border" /></div>
                                        
                                        <div><label className="text-xs font-bold block mb-1">เบอร์ติดต่อ {!isAdmin && <span className="text-red-500">*</span>}</label><input type="tel" name="tel" required={!isAdmin} maxLength="10" placeholder="08XXXXXXXX" defaultValue={modal.data.tel} className="w-full p-2.5 rounded-lg border" onInput={(e) => { e.target.value = e.target.value.replace(/[^0-9]/g, ''); }} /></div>

                                        {!isAdmin && (
                                            <div className="bg-red-50 text-red-600 text-[10px] p-3 rounded-lg border mt-2 font-bold flex gap-2"><Icons.Alert /> กรุณาอัปโหลดเอกสารแนบให้ครบ 3 ช่อง</div>
                                        )}
                                        <div className="bg-slate-50 p-4 rounded-xl border space-y-3 mt-4">
                                            <h4 className="text-sm font-bold border-b pb-2">อัปโหลดเอกสาร (รูป/PDF)</h4>
                                            {['layout', 'wiring', 'precheck'].map((doc) => {
                                                const currentUrl = docUrls[doc] || modal.data[`${doc}_img`];
                                                return (
                                                    <div key={doc} className="flex justify-between items-center gap-2 bg-white p-2 rounded-lg border shadow-sm">
                                                        <div>
                                                            <label className="text-[11px] font-bold uppercase">{doc} {!isAdmin && <span className="text-red-500">*</span>}</label>
                                                            {currentUrl && <div className="text-[9px] text-emerald-600 mt-0.5">✅ อัปโหลดแล้ว</div>}
                                                        </div>
                                                        <div className="flex gap-2">
                                                            {currentUrl && <button type="button" onClick={(e) => { e.preventDefault(); setViewFileUrl(currentUrl); }} className="text-[10px] text-blue-600 bg-blue-50 px-2 rounded font-bold">ดูไฟล์</button>}
                                                            <label className="bg-slate-800 text-white text-[10px] px-3 py-1.5 rounded cursor-pointer">{uploadingDoc[doc] ? 'รอ...' : 'ไฟล์'}
                                                                <input type="file" accept="image/*,application/pdf" className="hidden" onChange={(e) => handleFileUpload(e, doc)} disabled={uploadingDoc[doc]} />
                                                            </label>
                                                        </div>
                                                    </div>
                                                );
                                            })}
                                        </div>

                                        <button disabled={loadingMsg} className="w-full py-3.5 rounded-xl font-bold text-white bg-red-600 shadow-md mt-6">{loadingMsg ? 'บันทึก...' : 'บันทึกคิวงาน'}</button>
                                    </form>
                                </div>
                            )}
                        </div>
                    )}

                    {/* Modal จัดการวันลา/วันหยุด/กิจกรรม คงเดิม เพิ่ม UI Component ให้สวยงาม */}
                    {modal?.type === 'manage_leaves' && (
                        <div className="modal-card w-full max-w-md bg-white rounded-3xl animate-pop">
                            <div className="bg-amber-500 p-4 text-white flex justify-between"><h3 className="font-bold">จัดการวันลา</h3><button onClick={() => setModal(null)}><Icons.X /></button></div>
                            <div className="p-4 space-y-3">
                                <div className="relative">
                                    <div className="p-2 border rounded-lg cursor-pointer flex justify-between text-sm font-bold" onClick={() => setShowLeaveDropdown(!showLeaveDropdown)}>
                                        <span>{leaveInspectors.length === 0 ? '-- เลือกพนักงาน --' : leaveInspectors.includes('ALL') ? 'ทุกคน' : leaveInspectors.join(', ')}</span> <span>▼</span>
                                    </div>
                                    {showLeaveDropdown && (
                                        <div className="absolute z-10 w-full bg-white border rounded max-h-40 overflow-y-auto mt-1 shadow-lg">
                                            <label className="flex gap-2 p-3 hover:bg-amber-50 cursor-pointer border-b"><input type="checkbox" checked={leaveInspectors.includes('ALL')} onChange={(e) => setLeaveInspectors(e.target.checked ? ['ALL'] : [])} /> <b>ทุกคน</b></label>
                                            {(db.inspectors || []).map(i => (
                                                <label key={i.name} className="flex gap-2 p-3 hover:bg-slate-50 cursor-pointer border-b text-sm"><input type="checkbox" checked={leaveInspectors.includes(i.name)} onChange={(e) => setLeaveInspectors(prev => e.target.checked ? [...prev, i.name] : prev.filter(n => n !== i.name))} /> {i.name}</label>
                                            ))}
                                        </div>
                                    )}
                                </div>
                                <div className="grid grid-cols-2 gap-2">
                                    <div><label className="text-[10px] font-bold">วันที่เริ่ม</label><input type="date" value={leaveStartDate} onChange={(e) => setLeaveStartDate(e.target.value)} className="w-full p-2 border rounded-lg font-bold text-sm" /></div>
                                    <div><label className="text-[10px] font-bold">วันสิ้นสุด</label><input type="date" value={leaveEndDate} onChange={(e) => setLeaveEndDate(e.target.value)} className="w-full p-2 border rounded-lg font-bold text-sm" /></div>
                                </div>
                                <select className="w-full p-2 border rounded-lg font-bold text-sm" value={leaveType} onChange={(e) => setLeaveType(e.target.value)}><option value="ลาพักร้อน">ลาพักร้อน</option><option value="ลากิจ">ลากิจ</option><option value="ลาป่วย">ลาป่วย</option><option value="อื่นๆโปรดระบุ">อื่นๆ</option></select>
                                {leaveType === 'อื่นๆโปรดระบุ' && <input type="text" placeholder="ระบุประเภท..." value={customLeaveType} onChange={(e) => setCustomLeaveType(e.target.value)} className="w-full p-2 border rounded-lg bg-amber-50" />}
                                <button onClick={async () => {
                                    if(leaveInspectors.length === 0 || !leaveStartDate || !leaveEndDate) return setAlertMsg('กรอกให้ครบ');
                                    let type = leaveType === 'อื่นๆโปรดระบุ' ? customLeaveType : leaveType;
                                    setLoadingMsg('สร้างวันลา...');
                                    let targets = leaveInspectors.includes('ALL') ? (db.inspectors||[]).map(i=>i.name) : leaveInspectors;
                                    for (let t of targets) await apiAction({ action: 'create_multiple_bookings', dates: leaveDates, inspector_name: t, job_type: 'leave', site_name: type, user: user?.username }, null, true);
                                    await fetchCoreData(true, null); setLoadingMsg(null); setSuccessModal('บันทึกวันลาสำเร็จ'); setModal(null);
                                }} className="w-full py-3 bg-amber-500 text-white font-bold rounded-xl shadow-md">เพิ่มวันลา ({leaveDates.length} วัน)</button>
                            </div>
                        </div>
                    )}

                    {modal?.type === 'manage_events' && (
                        <div className="modal-card w-full max-w-md bg-white rounded-3xl animate-pop">
                            <div className="bg-emerald-500 p-4 text-white flex justify-between"><h3 className="font-bold">เพิ่มกิจกรรม</h3><button onClick={() => setModal(null)}><Icons.X /></button></div>
                            <div className="p-4 space-y-3">
                                <input type="text" id="ev_input" placeholder="ชื่อกิจกรรม..." className="w-full p-2 border rounded-lg font-bold" />
                                <div className="grid grid-cols-2 gap-2">
                                    <div><label className="text-[10px] font-bold">วันที่เริ่ม</label><input type="date" value={eventStartDate} onChange={(e) => setEventStartDate(e.target.value)} className="w-full p-2 border rounded-lg font-bold text-sm" /></div>
                                    <div><label className="text-[10px] font-bold">วันสิ้นสุด</label><input type="date" value={eventEndDate} onChange={(e) => setEventEndDate(e.target.value)} className="w-full p-2 border rounded-lg font-bold text-sm" /></div>
                                </div>
                                <button onClick={async () => {
                                    const v = document.getElementById('ev_input').value; if(!v || !eventStartDate) return setAlertMsg('ระบุให้ครบ');
                                    const ok = await apiAction({ action: 'create_multiple_bookings', dates: eventDates, inspector_name: 'SYSTEM_EVENT', job_type: 'company_event', site_name: v, user: user?.username }, 'สร้างกิจกรรม...');
                                    if(ok) { setSuccessModal('สำเร็จ'); setModal(null); }
                                }} className="w-full py-3 bg-emerald-500 text-white font-bold rounded-xl shadow-md">สร้างกิจกรรม</button>
                            </div>
                        </div>
                    )}

                    {modal?.type === 'manage_holidays' && (
                        <div className="modal-card w-full max-w-md bg-white rounded-3xl animate-pop">
                            <div className="bg-red-600 p-4 text-white flex justify-between"><h3 className="font-bold">เพิ่มวันหยุด</h3><button onClick={() => setModal(null)}><Icons.X /></button></div>
                            <div className="p-4 space-y-3">
                                <input type="text" id="hd_input" placeholder="ชื่อวันหยุด..." className="w-full p-2 border rounded-lg font-bold" />
                                <div className="grid grid-cols-2 gap-2">
                                    <div><label className="text-[10px] font-bold">วันที่เริ่ม</label><input type="date" value={holidayStartDate} onChange={(e) => setHolidayStartDate(e.target.value)} className="w-full p-2 border rounded-lg font-bold text-sm" /></div>
                                    <div><label className="text-[10px] font-bold">วันสิ้นสุด</label><input type="date" value={holidayEndDate} onChange={(e) => setHolidayEndDate(e.target.value)} className="w-full p-2 border rounded-lg font-bold text-sm" /></div>
                                </div>
                                <button onClick={async () => {
                                    const v = document.getElementById('hd_input').value; if(!v || !holidayStartDate) return setAlertMsg('ระบุให้ครบ');
                                    const ok = await apiAction({ action: 'create_multiple_bookings', dates: holidayDates, inspector_name: 'SYSTEM_HOLIDAY', job_type: 'public_holiday', site_name: v, user: user?.username }, 'สร้างวันหยุด...');
                                    if(ok) { setSuccessModal('สำเร็จ'); setModal(null); }
                                }} className="w-full py-3 bg-red-600 text-white font-bold rounded-xl shadow-md">เพิ่มวันหยุด</button>
                            </div>
                        </div>
                    )}

                </div>
            )}

            {/* Global Modal ไฟล์ */}
            {viewFileUrl && (
                <div className="backdrop z-[700] p-4 flex flex-col items-center justify-center">
                    <div className="w-full max-w-4xl bg-white rounded-3xl overflow-hidden flex flex-col h-[85vh] shadow-2xl animate-pop">
                        <div className="bg-slate-800 text-white p-3 flex justify-between items-center"><span className="font-bold text-sm">ดูไฟล์แนบ</span><div className="flex gap-2"><button onClick={() => window.open(viewFileUrl, '_blank')} className="bg-blue-600 px-3 py-1.5 rounded-lg text-xs font-bold">เปิดแท็บใหม่</button><button onClick={() => setViewFileUrl(null)} className="bg-white/20 p-1.5 rounded-full"><Icons.X /></button></div></div>
                        <div className="flex-1 bg-slate-100 p-2">
                            {viewFileUrl.endsWith('.pdf') || viewFileUrl.includes('preview') || viewFileUrl.includes('drive.google.com') ? (
                                <iframe src={viewFileUrl} className="w-full h-full border-0 rounded-xl shadow-sm" allow="autoplay" />
                            ) : ( <div className="w-full h-full flex items-center justify-center p-2"><img src={viewFileUrl} className="max-w-full max-h-full object-contain rounded-lg shadow-sm" /></div> )}
                        </div>
                    </div>
                </div>
            )}

            {/* หน้าต่างการแจ้งเตือน (แยก Logic ไม่ Error แล้ว) */}
            {showActivityModal && (
                <div className="backdrop z-[200]">
                    <div className="modal-card p-6 h-[85vh] flex flex-col relative">
                        <button onClick={() => setShowActivityModal(false)} className="btn-close-modern"><Icons.X /></button>
                        <h3 className="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2"><Icons.Bell /> การแจ้งเตือน & ประวัติ</h3>
                        
                        <div className="flex gap-2 mb-4 bg-slate-100 p-1 rounded-xl">
                            <button onClick={() => setActivityTab('notif')} className={`flex-1 py-2 text-xs font-bold rounded-lg ${activityTab === 'notif' ? 'bg-white shadow-sm text-blue-600' : 'text-slate-500'}`}>🔔 แจ้งเตือน ({unreadNotifs.length})</button>
                            <button onClick={() => { setActivityTab('log'); if(!hasLoadedAdmin) fetchAdminData(0, 50, 'logs'); }} className={`flex-1 py-2 text-xs font-bold rounded-lg ${activityTab === 'log' ? 'bg-white shadow-sm text-slate-800' : 'text-slate-500'}`}>🗄️ ประวัติระบบ</button>
                        </div>

                        <div className="overflow-y-auto flex-1 pr-2 space-y-3 custom-scrollbar">
                            {activityTab === 'notif' ? (
                                (() => {
                                    const userNotifs = (db.notifications || []).filter(n => n.target === user?.username || (isAdmin && n.target === 'ALL_ADMIN')).sort((a,b) => new Date(b.timestamp) - new Date(a.timestamp));
                                    if (userNotifs.length === 0) return <div className="text-center text-slate-400 py-12">ไม่มีรายการแจ้งเตือน</div>;

                                    return userNotifs.map((notif, i) => {
                                        const readers = String(notif.isRead || '').split(',');
                                        const isUnread = !readers.includes(user?.username);

                                        return (
                                            <div key={notif.id || i} onClick={() => { if(isUnread) handleReadNotification(notif); }}
                                                 className={`p-4 rounded-xl border shadow-sm cursor-pointer ${isUnread ? 'bg-blue-50/80 border-blue-300 ring-1 ring-blue-300' : 'bg-white border-slate-200 opacity-75'}`}>
                                                <div className="flex justify-between items-start mb-2">
                                                    <div className="font-bold text-sm text-slate-800 flex items-center gap-2">
                                                        {isUnread && <span className="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>} {notif.title || 'แจ้งเตือนระบบ'}
                                                    </div>
                                                    <div className="text-[9px] text-slate-400 bg-slate-50 px-2 py-1 rounded-md border">
                                                        {notif.timestamp ? new Date(notif.timestamp).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : ''}
                                                    </div>
                                                </div>
                                                <div className="text-xs text-slate-700 whitespace-pre-line">{notif.message}</div>
                                            </div>
                                        );
                                    });
                                })()
                            ) : (
                                (() => {
                                    if (!hasLoadedAdmin) return <div className="text-center text-slate-400 p-8"><Icons.Loader /> โหลดประวัติ...</div>;
                                    const logsList = (adminDb.logs || []).sort((a,b) => new Date(b.timestamp) - new Date(a.timestamp));
                                    if (logsList.length === 0) return <div className="text-center text-slate-400 py-12">ไม่พบประวัติระบบ</div>;
                                    return logsList.slice(0, logsLimit).map((log, i) => (
                                        <div key={i} className="bg-slate-50 p-4 rounded-xl border shadow-sm">
                                            <div className="flex justify-between items-start mb-2">
                                                <div className="flex items-center gap-2"><div className="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center text-slate-500"><Icons.User /></div><div className="text-[10px] font-bold text-slate-700">{log.user || '-'}</div></div>
                                                <div className="text-[9px] text-slate-400">{log.timestamp ? new Date(log.timestamp).toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' }) : ''}</div>
                                            </div>
                                            <div className="mb-2"><span className={`px-2 py-1 rounded-md text-[9px] font-bold inline-block ${String(log.action).includes('CREATE') ? 'bg-green-100 text-green-700' : String(log.action).includes('UPDATE') ? 'bg-blue-100 text-blue-700' : 'bg-red-100 text-red-700'}`}>{log.action}</span></div>
                                            <div className="text-[11px] font-mono text-slate-600 whitespace-pre-wrap">{log.details}</div>
                                        </div>
                                    ));
                                })()
                            )}
                        </div>
                    </div>
               </div>
            )}
        </div>
    );
};

class ErrorBoundary extends React.Component {
    constructor(props) { super(props); this.state = { hasError: false, errorMsg: '' }; }
    static getDerivedStateFromError(error) { return { hasError: true, errorMsg: error.toString() }; }
    componentDidCatch(error, errorInfo) { console.error("Error:", error); }
    render() {
        if (this.state.hasError) return ( <div className="h-screen w-full flex flex-col items-center justify-center bg-slate-50 p-6 text-center"><div className="text-red-500 mb-4"><Icons.Alert /></div><h2 className="text-xl font-bold mb-2">ระบบขัดข้องชั่วคราว</h2><button onClick={() => window.location.reload()} className="bg-red-600 text-white px-6 py-2 rounded-xl font-bold mt-4">รีเฟรชหน้าเว็บ</button></div> );
        return this.props.children;
    }
}

const rootElement = document.getElementById('root');
if (rootElement) { const root = ReactDOM.createRoot(rootElement); root.render(<ErrorBoundary><App /></ErrorBoundary>); }
