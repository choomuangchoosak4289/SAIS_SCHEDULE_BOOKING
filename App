                            <span className="absolute -top-1 -right-1 bg-red-500 text-white text-[9px] font-black w-[18px] h-[18px] flex items-center justify-center rounded-full border border-white animate-pulse shadow-sm">
                                {unreadNotifs.length > 99 ? '99+' : unreadNotifs.length}
                            </span>
                        )}
                    </button>
                    <div className="text-xs font-bold bg-white/20 px-3 py-1.5 rounded-lg flex items-center gap-1"><Icons.User /> {user.username}</div>
                </div>
            </header>

