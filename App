                            <select className="text-xs border rounded-lg p-2 bg-white w-32 shadow-sm font-bold" value={filterArea} onChange={(e) => setFilterArea(e.target.value)}><option value="All">ทุกพื้นที่</option><option value="กรุงเทพและปริมณฑล">กทม.</option><option value="เชียงใหม่">เชียงใหม่</option><option value="ภูเก็ต">ภูเก็ต</option></select>
                        </div>
                        <div className="flex items-center bg-white border rounded-xl px-3 py-3 shadow-sm">
                            <div className="text-slate-400 mr-2"><Icons.Search /></div>
                            <input type="text" placeholder="พิมพ์ Eq No., โครงการ, หรือผู้ตรวจ..." className="w-full text-sm outline-none font-bold" value={localSearchQuery} onChange={(e) => setLocalSearchQuery(e.target.value)} />
                            {localSearchQuery && <button onClick={() => { setLocalSearchQuery(''); setSearchQuery(''); }} className="text-slate-400 p-1"><Icons.X /></button>}
                        </div>
                    </div>
                    <div className="space-y-3 pb-10">
                        {!hasLoadedAdmin ? <div className="text-center text-slate-400 p-8 mt-4"><Icons.Loader /> กำลังโหลดข้อมูล...</div> : searchQuery.trim() === '' && filterArea === 'All' ? <div className="text-center text-slate-400 p-8 mt-4">เริ่มค้นหา...</div> : 
                            (adminDb.all_bookings || []).filter(b => {
                                if (String(b.status) === 'cancelled' || String(b.inspector_name).startsWith('SYSTEM_')) return false;
                                const matchSearch = String(b.equipment_no || '').toLowerCase().includes(searchQuery.toLowerCase()) || String(b.site_name || '').toLowerCase().includes(searchQuery.toLowerCase()) || String(b.inspector_name || '').toLowerCase().includes(searchQuery.toLowerCase());
                                return (filterArea === 'All' || String(b.area || '') === filterArea) && matchSearch;
                            }).sort((a, b) => new Date(b.date) - new Date(a.date)).slice(0, 50).map((h, i) => (
                                <div key={i} className="bg-white p-4 rounded-xl shadow-sm border cursor-pointer hover:border-blue-400" onClick={() => setModal({ type: 'detail', data: h })}>
                                    <div className="flex justify-between items-start mb-2"><div className="font-bold text-sm truncate">{h.site_name || '-'}</div><div className="text-[10px] font-bold bg-blue-50 text-blue-600 px-2 py-1 rounded-md">{h.date ? formatSafeDate(h.date) : '-'}</div></div>
                                    <div className="grid grid-cols-2 gap-1.5 text-xs bg-slate-50 p-2 rounded-lg mt-2">
                                        <div><span className="text-slate-400 text-[10px] block">Eq No.</span> <span className="font-bold text-slate-700">{h.equipment_no || '-'}</span></div>
                                        <div><span className="text-slate-400 text-[10px] block">ผู้ตรวจ</span> <span className="font-bold text-slate-700">{h.inspector_name || '-'}</span></div>
                                        <div><span className="text-slate-400 text-[10px] block">Unit</span> <span className="font-bold text-slate-700">{h.unit_no || '-'}</span></div>
                                        <div><span className="text-slate-400 text-[10px] block">พื้นที่</span> <span className="font-bold text-slate-700">{h.area || '-'}</span></div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            )}
            
            {/* งานของฉัน */}
            {currentView === 'my_bookings' && !isAdmin && (
                <div className="page-view relative pb-20">
                    <div className="flex justify-between items-center mb-4">
                        <h2 className="text-xl font-bold text-slate-800 flex items-center gap-2"><Icons.List /> {user?.role === 'inspector' ? 'คิวงานตรวจของฉัน' : 'งานที่ฉันจองไว้'}</h2>
                        <button onClick={() => setShowRoleHelp(!showRoleHelp)} className="text-[10px] font-bold text-blue-600 bg-blue-50 px-3 py-1.5 rounded-full border border-blue-200 flex items-center gap-1"><Icons.HelpCircle /> วิธีใช้งานหน้านี้</button>
                    </div>

                    {showRoleHelp && (
                        <div className="bg-slate-800 text-white p-4 rounded-xl mb-4 text-xs relative">
                            <button onClick={() => setShowRoleHelp(false)} className="absolute top-3 right-3 text-slate-400"><Icons.X /></button>
                            <h3 className="font-bold text-sm mb-2 text-blue-300">{user?.role === 'inspector' ? '🛠️ คู่มือสำหรับ Inspector' : '📌 คู่มือสำหรับผู้จอง (Viewer)'}</h3>
                            <ul className="list-disc pl-4 space-y-1.5">
                                <li><b>⏳ คิวรอตรวจ/รอดำเนินการ:</b> คิวที่ยังตรวจเอกสารแนบไม่ครบ</li>
                                <li><b>✅ อนุมัติแล้ว:</b> คิวที่ Admin ตรวจเอกสารครบแล้ว พร้อมดำเนินงาน</li>
                                <li><b>🗄️ ประวัติที่ผ่านมา:</b> คิวที่วันที่ผ่านไปแล้ว</li>
                            </ul>
                        </div>
                    )}

                    <div className="flex gap-2 mb-4 bg-slate-100 p-1 rounded-lg">
                        <button onClick={() => setMyBookingsTab('pending')} className={`flex-1 py-2 text-xs font-bold rounded-md ${myBookingsTab === 'pending' ? 'bg-white shadow-sm text-amber-600' : 'text-slate-500'}`}>⏳ รอดำเนินการ</button>
                        <button onClick={() => setMyBookingsTab('approved')} className={`flex-1 py-2 text-xs font-bold rounded-md ${myBookingsTab === 'approved' ? 'bg-white shadow-sm text-green-600' : 'text-slate-500'}`}>✅ อนุมัติแล้ว</button>
