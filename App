                setConfirmDialog(null); setDraggingTask(null);
                const logDetail = `[ย้ายคิวงาน]\nโดย: ${user?.username}\nวันที่: [${oldDate}] ➡️ [${targetDate}]`;
                const ok = await apiAction({ action: 'update_booking', id: task.id, date: targetDate, inspector_name: finalInspector, user: user?.username, reason: logDetail }, 'กำลังย้ายข้อมูล...');
                if (ok) setSuccessModal('ลากย้ายรายการสำเร็จ');
            }
        });
    };

