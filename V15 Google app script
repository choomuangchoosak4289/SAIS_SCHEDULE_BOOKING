            createNotification('ALL_ADMIN', '🗑️ ยกเลิกคิวงาน: ' + (data.equipment_no || 'ไม่ระบุ') + ' โดย ' + data.user);
          } else {
            for (var key in data) {
              if (key !== 'action' && key !== 'id' && key !== 'user' && key !== 'api_key') {
                var colIndex = headers.indexOf(key);
                if (colIndex !== -1) {
                  var valToSave = data[key];
                  if (key === 'phone' || key === 'tel') valToSave = "'" + valToSave;
                  sheet.getRange(rowIndex, colIndex + 1).setValue(valToSave);
                }
              }
            }
            logAction(data.user, 'UPDATE_BOOKING', (data.reason || 'แก้ไขข้อมูลงาน'));
            createNotification('ALL_ADMIN', '✏️ แก้ไขข้อมูลคิวงาน: ' + (data.equipment_no || 'ไม่ระบุ') + ' โดย ' + data.user);
          }
          SpreadsheetApp.flush();
          return respond({ status: 'ok' });
        }
        return respond({ status: 'error', message: 'ไม่พบ ID งานที่ระบุ' });
      }

      if (action === 'read_notification') {
        var sheet = ss.getSheetByName('Notifications'); 
        var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0]; 
        var foundCell = sheet.createTextFinder(String(data.id)).matchEntireCell(true).findNext();
        
        if(foundCell) { 
          var isReadCol = headers.indexOf('isRead');
          if (isReadCol !== -1) {
            var currentRow = foundCell.getRow();
            var currentReaders = String(sheet.getRange(currentRow, isReadCol + 1).getValue() || '');
            
            var readersArray = currentReaders === '' ? [] : currentReaders.split(',');
            if (readersArray.indexOf(data.user) === -1) {
              readersArray.push(data.user);
              sheet.getRange(currentRow, isReadCol + 1).setValue(readersArray.join(','));
            }
            return respond({ status: 'ok' }); 
          }
        }
        return respond({ status: 'error' });
      }

      if (action === 'manage_inspector') {
        var sheet = ss.getSheetByName("Inspectors");
        var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
        var nameIdx = headers.indexOf("name");
        var prodIdx = headers.indexOf("product_lines");

        if (data.sub_action === 'add') {
          var rowData = new Array(headers.length).fill("");
          rowData[nameIdx] = data.new_name;
          if (prodIdx !== -1) rowData[prodIdx] = data.product_lines || "";
          sheet.appendRow(rowData);
        } 
        else if (data.sub_action === 'update' || data.sub_action === 'delete') {
          var range = sheet.getDataRange();
          var values = range.getValues();
          for (var i = 1; i < values.length; i++) {
            if (String(values[i][nameIdx]) === String(data.old_name)) {
              if (data.sub_action === 'delete') {
                sheet.deleteRow(i + 1);
              } else {
                sheet.getRange(i + 1, nameIdx + 1).setValue(data.new_name);
                if (prodIdx !== -1) sheet.getRange(i + 1, prodIdx + 1).setValue(data.product_lines || "");
              }
              break;
            }
          }
        }
        SpreadsheetApp.flush();
        return respond({status: 'ok'});
      }

      return respond({ status: 'error', message: 'Unknown action' });

    } finally {
      // 🔒 ปลดล็อคเสมอเมื่อทำงาน Write เสร็จสิ้น เพื่อให้คิวต่อไปทำงานต่อ
      lock.releaseLock();
    }

  } catch (err) {
    return respond({ status: 'error', message: err.toString() });
  }
}

function respond(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }

function getSheetDataAsObjects(sheet) {
  if (!sheet) return []; var data = sheet.getDataRange().getValues(); if (data.length < 2) return []; var headers = data[0]; var result = [];
  for (var i = 1; i < data.length; i++) { var obj = {}; for (var j = 0; j < headers.length; j++) { obj[headers[j]] = data[i][j]; } result.push(obj); }
  return result;
}

function logAction(user, action, details) {
  var sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName("Logs");
  if (!sheet) return;
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var rowData = new Array(headers.length).fill("");
  for (var i = 0; i < headers.length; i++) {
    var h = headers[i];
    if (h === 'timestamp' || h === 'created_at') rowData[i] = getThaiTime();
    else if (h === 'user') rowData[i] = user;
    else if (h === 'action') rowData[i] = action;
    else if (h === 'details') rowData[i] = details;
  }
  sheet.appendRow(rowData);
}

function createNotification(target, message) {
  var sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName("Notifications");
  if (!sheet) return;
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var rowData = new Array(headers.length).fill("");
  for (var i = 0; i < headers.length; i++) {
    var h = headers[i];
    if (h === 'id') rowData[i] = Utilities.getUuid();
    else if (h === 'target') rowData[i] = target;
    else if (h === 'message') rowData[i] = message;
    else if (h === 'timestamp' || h === 'created_at') rowData[i] = getThaiTime();
    else if (h === 'isRead') rowData[i] = ""; // ค่าเริ่มต้นเป็นค่าว่าง รองรับการอ่านทีละคน
    else if (h === 'title') rowData[i] = 'แจ้งเตือนระบบ';
  }
  sheet.appendRow(rowData);
}
