          createNotification(data.target_user, 'บัญชีของคุณได้รับการ ' + (data.new_status === 'approved' ? 'อนุมัติแล้ว' : 'ระงับการใช้งาน'));
          SpreadsheetApp.flush();
          return respond({ status: 'ok' });
        }
        return respond({ status: 'error', message: 'ไม่พบผู้ใช้' });
      }

      if (action === 'delete_user') {
        var sheet = ss.getSheetByName('Users');
        var foundCell = sheet.createTextFinder(String(data.target_user)).matchEntireCell(true).findNext();
